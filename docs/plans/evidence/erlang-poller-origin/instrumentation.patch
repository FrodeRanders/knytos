+
+/// Safety: the condition stays live and the caller holds the scheduler mutex.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn knytos_handoff_waiter_state(condition: *const Condition) -> u32 {
+    let state = unsafe { &*condition }.0.lock();
+    u32::from(state.pending != 0) | (u32::from(state.in_flight != 0) << 1)
+}
+
+/// Safety: both lock objects and the diagnostic output remain live throughout
+/// the operation. Only the caller has access to the output.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn knytos_handoff_condition_wait_event(
+    condition: *const Condition,
+    mutex: *const NativeMutex,
+    reacquire_ms: u32,
+    waited: *mut u32,
+) -> i32 {
+    let (Some(condition), Some(mutex), Some(caller), Some(waited)) =
+        (unsafe { condition.as_ref() }, unsafe { mutex.as_ref() }, participant(), unsafe {
+            waited.as_mut()
+        })
+    else {
+        return INVALID;
+    };
+    let mut parks = 0;
+    let status = condition.wait(mutex, caller, None, reacquire_ms, &mut parks);
+    *waited = u32::from(parks != 0);
+    status
 }

