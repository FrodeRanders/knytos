@@ -18,6 +18,46 @@ static struct SchedulerWorker {

 static atomic_uint scheduled_workers;

+static _Atomic uint64_t elected_immediate;
+static _Atomic uint64_t busy_immediate;
+static _Atomic uint64_t elected_waited;
+static _Atomic uint64_t busy_waited;
+static _Atomic uint64_t scan_runnable;
+static _Atomic uint64_t scan_empty;
+
+// The scheduler mutex protects this diagnostic state. Print it after join.
+enum PollerOrigin { POLLER_UNOBSERVED, POLLER_FRESH, POLLER_CONDITION };
+static enum PollerOrigin poller_origin;
+static uint64_t fresh_by_waiter_state[4];
+static uint64_t misses_by_origin[3];
+
+extern uint32_t knytos_handoff_waiter_state(const struct knytos_condition *);
+
+void knytos_handoff_fresh(CondVar *condition)
+{
+    uint32_t state = knytos_handoff_waiter_state((struct knytos_condition *) condition);
+    ++fresh_by_waiter_state[state];
+    poller_origin = POLLER_FRESH;
+}
+
+void knytos_handoff_return(bool elected, bool waited)
+{
+    _Atomic uint64_t *counter = waited
+        ? (elected ? &elected_waited : &busy_waited)
+        : (elected ? &elected_immediate : &busy_immediate);
+    atomic_fetch_add_explicit(counter, 1, memory_order_relaxed);
+    if (elected) {
+        poller_origin = POLLER_CONDITION;
+    } else {
+        ++misses_by_origin[poller_origin];
+    }
+}
+
+void knytos_handoff_first_scan(bool runnable)
+{
+    atomic_fetch_add_explicit(runnable ? &scan_runnable : &scan_empty, 1, memory_order_relaxed);
+}
