+pub(crate) mod handoff_profile {
+    use core::sync::atomic::{
+        AtomicU64,
+        Ordering,
+    };
+
+    use crate::workers::{
+        PARTICIPANT_COUNT,
+        Participant,
+    };
+
+    const SAMPLE_STRIDE: u64 = 64;
+    const LIMITS_US: [u64; 13] = [2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192];
+    type Histogram = [AtomicU64; LIMITS_US.len() + 1];
+    const EMPTY: Histogram = [const { AtomicU64::new(0) }; LIMITS_US.len() + 1];
+
+    #[repr(align(128))]
+    struct Slot {
+        waits: AtomicU64,
+        reacquired: AtomicU64,
+        contended: AtomicU64,
+        park_calls: AtomicU64,
+        wait_durations: Histogram,
+        lock_durations: Histogram,
+    }
+
+    static SLOTS: [Slot; PARTICIPANT_COUNT] = [const {
+        Slot {
+            waits: AtomicU64::new(0),
+            reacquired: AtomicU64::new(0),
+            contended: AtomicU64::new(0),
+            park_calls: AtomicU64::new(0),
+            wait_durations: EMPTY,
+            lock_durations: EMPTY,
+        }
+    }; PARTICIPANT_COUNT];
+
+    fn row(caller: Participant) -> &'static Slot {
+        &SLOTS[caller.slot as usize]
+    }
+
+    fn add(counter: &AtomicU64, count: u64) {
+        // Each live roster slot has one writer; read the counters after join.
+        counter.store(counter.load(Ordering::Relaxed) + count, Ordering::Relaxed);
+    }
+
+    pub(super) fn begin(caller: Participant) -> Option<(u64, u64)> {
+        let count = &row(caller).waits;
+        add(count, 1);
+        (count.load(Ordering::Relaxed) % SAMPLE_STRIDE == 0).then(knytos_rt::abi::monotonic_clock)
+    }
+
+    pub(super) fn selected(caller: Participant, start: Option<(u64, u64)>) -> Option<(u64, u64)> {
+        start.map(|start| finish(&row(caller).wait_durations, start))
+    }
+
+    pub(super) fn reacquired(caller: Participant, start: Option<(u64, u64)>, parks: u64) {
+        let row = row(caller);
+        if let Some(start) = start {
+            finish(&row.lock_durations, start);
+        }
+        add(&row.reacquired, 1);
+        add(&row.contended, u64::from(parks != 0));
+        add(&row.park_calls, parks);
+    }
+
+    fn finish(histogram: &Histogram, (start, frequency): (u64, u64)) -> (u64, u64) {
+        let (end, observed_frequency) = knytos_rt::abi::monotonic_clock();
+        assert!(end >= start && frequency != 0 && frequency == observed_frequency);
+        let usec = (end - start).saturating_mul(1_000_000).div_ceil(frequency);
+        add(&histogram[LIMITS_US.partition_point(|&limit| limit < usec)], 1);
+        (end, frequency)
+    }
+
+    pub(crate) fn report() {
+        for (slot, row) in SLOTS.iter().enumerate() {
+            knytos_rt::logln!(
+                "[cabi-handoff] slot={} waits={} reacquired={} contended={} parks={}",
+                slot,
+                row.waits.load(Ordering::Relaxed),
+                row.reacquired.load(Ordering::Relaxed),
+                row.contended.load(Ordering::Relaxed),
+                row.park_calls.load(Ordering::Relaxed),
+            );
+            knytos_rt::logln!(
+                "[cabi-handoff] slot={} wait_us={:?}",
+                slot,
+                row.wait_durations.each_ref().map(|value| value.load(Ordering::Relaxed))
+            );
+            knytos_rt::logln!(
+                "[cabi-handoff] slot={} lock_us={:?}",
+                slot,
+                row.lock_durations.each_ref().map(|value| value.load(Ordering::Relaxed))
+            );
+        }
+    }
+}
