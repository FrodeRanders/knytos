--- a/erts/lib_src/Makefile.in
+++ b/erts/lib_src/Makefile.in
@@ -267,12 +267,24 @@
 #
 ETHR_THR_LIB_BASE_DIR=@ETHR_THR_LIB_BASE_DIR@
 ifneq ($(strip $(ETHR_LIB_NAME)),)
+ifeq ($(ETHR_THR_LIB_BASE_DIR),knytos)
+ETHREAD_LIB_SRC=knytos/ethr_event.c \
+		knytos/ethr_tsd.c \
+		knytos/ethr_thread.c \
+		knytos/ethr_mutex.c \
+		knytos/ethr_rwmutex.c \
+		knytos/ethr_lock.c \
+		knytos/ethr_ts_event.c \
+		knytos/ethr_atomic_info.c \
+		knytos/ethr_diagnostics.c
+else
 ETHREAD_LIB_SRC=common/ethr_aux.c \
 		common/ethr_atomics.c \
 		common/ethr_mutex.c \
 		common/ethr_cbf.c \
 		$(ETHR_THR_LIB_BASE_DIR)/ethread.c \
 		$(ETHR_THR_LIB_BASE_DIR)/ethr_event.c
+endif
 ETHR_X86_SSE2_ASM=@ETHR_X86_SSE2_ASM@
 ifeq ($(ETHR_X86_SSE2_ASM),yes)
 ETHREAD_LIB_SRC += pthread/ethr_x86_sse2_asm.c
