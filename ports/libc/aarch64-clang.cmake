set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER clang)
set(CMAKE_ASM_COMPILER clang)
set(CMAKE_C_COMPILER_TARGET aarch64-none-elf)
set(CMAKE_ASM_COMPILER_TARGET aarch64-none-elf)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES KNYTOS_LLVM_AR KNYTOS_WORKER_LIBC)
if(NOT KNYTOS_LLVM_AR)
  message(FATAL_ERROR "Pass the pinned Rust toolchain's KNYTOS_LLVM_AR")
endif()
set(CMAKE_AR "${KNYTOS_LLVM_AR}")
set(CMAKE_C_ARCHIVE_FINISH "<CMAKE_AR> s <TARGET>")
set(CMAKE_C_FLAGS_INIT "-ffreestanding -fno-stack-protector -fno-pic -fno-pie -mno-outline-atomics -ffunction-sections -fdata-sections")
if(KNYTOS_WORKER_LIBC)
  # The pinned upstream CMake header lacks the Meson stdio-locking option.
  string(APPEND CMAKE_C_FLAGS_INIT " -D__STDIO_LOCKING")
endif()
set(CMAKE_ASM_FLAGS_INIT "--target=aarch64-none-elf")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
